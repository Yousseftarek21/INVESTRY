{
  "expo": {
    "name": "INVESTRY",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/531fc79f-b55d-4644-99db-10b9cc15a93a",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.investry.app",
      "buildNumber": "56",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.investry.app",
      "versionCode": 41,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "transparent",
        "translucent": true
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://investry.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A9821E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "INVESTRY needs access to your photo library so you can choose a picture from it to use as your profile photo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "INVESTRY uses Face ID to unlock the app, so only you can view your portfolio and financial information."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "investrytest3",
    "extra": {
      "eas": {
        "projectId": "531fc79f-b55d-4644-99db-10b9cc15a93a"
      }
    }
  }
}
